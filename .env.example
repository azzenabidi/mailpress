# Copy to .env and fill in your values. .env is gitignored.

# Resend API key (https://resend.com/api-keys) — used for outbound mail and
# for the Action Mailbox ingress to fetch full inbound messages.
RESEND_API_KEY=

# svix signing secret of the "email.received" webhook (whsec_...), shown once
# when you create the webhook in the Resend dashboard.
RESEND_INGRESS_SIGNING_SECRET=

# Comma-separated list of addresses allowed to publish posts.
# Supports "@domain" wildcards, e.g. me@example.com,*@myteam.dev
# Leave empty in development to accept everyone.
MAILPRESS_ALLOWED_SENDERS=

# From address for confirmation/bounce emails. Must be on a verified Resend domain.
MAILPRESS_MAIL_FROM="Mailpress <onboarding@resend.dev>"

# Public host of the app, used in email links (production).
MAILPRESS_HOST=localhost:3000
