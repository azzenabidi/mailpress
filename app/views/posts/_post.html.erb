<article id="<%= dom_id(post) %>" class="group">
  <time datetime="<%= post.published_at&.iso8601 %>" class="text-sm text-slate-500">
    <%= post.published_at&.to_date&.to_fs(:long) %>
  </time>

  <h2 class="mt-1 text-2xl font-bold tracking-tight">
    <%= link_to post.title, post_path(post), class: "group-hover:text-indigo-600" %>
  </h2>

  <p class="mt-3 leading-7 text-slate-600">
    <%= post.excerpt %>
  </p>

  <%= link_to "Read more →", post_path(post), class: "mt-3 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
</article>
