<% content_for(:title, "#{@post.title} — Mailpress") %>

<article>
  <header>
    <h1 class="text-4xl font-bold tracking-tight"><%= @post.title %></h1>
    <div class="mt-3 flex items-center gap-4 text-sm text-slate-500">
      <time datetime="<%= @post.published_at&.iso8601 %>">
        <%= @post.published_at&.to_date&.to_fs(:long) %>
      </time>
      <button type="button"
              data-controller="copy"
              data-copy-link-value="<%= post_url(@post) %>"
              data-action="copy#copy"
              class="rounded-md border border-slate-200 px-2 py-1 text-xs hover:border-indigo-400 hover:text-indigo-600">
        <span data-copy-target="label">Copy link</span>
      </button>
    </div>
  </header>

  <div class="prose mt-8 max-w-none text-slate-700 leading-7 trix-content">
    <%= @post.content %>
  </div>

  <% if @post.images.attached? %>
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <% @post.images.each do |image| %>
        <%= image_tag image.variant(resize_to_limit: [ 1200, 800 ]),
              class: "w-full rounded-lg border border-slate-200",
              alt: image.filename %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-10 border-t border-slate-200 pt-6">
    <%= link_to "← All posts", root_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
  </div>
</article>
